-- 5. ล็อกหัว (Aimbot)
local AimbotEnabled = false

local function GetClosestEnemyHead()
    local closestHead = nil
    local shortestDistance = math.huge

    for _, player in pairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local isTeammate = (LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team)
            if not isTeammate then
                local head = player.Character.Head
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local distance = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestHead = head
                    end
                end
            end
        end
    end
    return closestHead
end

RunService.RenderStepped:Connect(function()
    if AimbotEnabled then
        local targetHead = GetClosestEnemyHead()
        if targetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end
end)

CombatTab:CreateToggle({
   Name = "ล็อกหัวศัตรูอัตโนมัติ (Aimbot Head)",
   CurrentValue = false,
   Flag = "AimbotToggle",
   Callback = function(Value)
      AimbotEnabled = Value
   end,
})

-- 6. มองทะลุแยกทีม (ESP: เพื่อน = เขียว / ศัตรู = แดง)
local ESPEnabled = false

local function GetTeamColor(player)
    if LocalPlayer.Team and player.Team then
        if player.Team == LocalPlayer.Team then
            return Color3.fromRGB(0, 255, 0) -- เขียว (ทีมเดียวกัน)
        else
            return Color3.fromRGB(255, 0, 0) -- แดง (ศัตรู)
        end
    else
        return Color3.fromRGB(255, 0, 0) -- ไม่มีระบบทีม ถือเป็นศัตรูทั้งหมด
    end
end

local function ApplyESP(player)
    if player ~= LocalPlayer and player.Character then
        local existingHighlight = player.Character:FindFirstChild("YOUShop_ESP")
        if ESPEnabled then
            local targetColor = GetTeamColor(player)
            if not existingHighlight then
                local hl = Instance.new("Highlight")
                hl.Name = "YOUShop_ESP"
                hl.FillColor = targetColor
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.4
                hl.Parent = player.Character
            else
                existingHighlight.FillColor = targetColor
            end
        else
            if existingHighlight then
                existingHighlight:Destroy()
            end
        end
    end
end

CombatTab:CreateToggle({
   Name = "มองทะลุแยกสี (เพื่อนเขียว / ศัตรูแดง)",
   CurrentValue = false,
   Flag = "ESPToggle",
   Callback = function(Value)
      ESPEnabled = Value
      for _, player in pairs(game.Players:GetPlayers()) do
          ApplyESP(player)
      end
   end,
})

RunService.Stepped:Connect(function()
    if ESPEnabled then
        for _, player in pairs(game.Players:GetPlayers()) do
            ApplyESP(player)
        end
    end
end)

