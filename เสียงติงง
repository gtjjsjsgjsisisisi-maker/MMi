-- TAB 3: ระบบมอง ESP
-- ========================================================

local ESPEnabled = false

local function ApplyESP(model, color, labelText)
    if not model:FindFirstChild("ESP_Highlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "ESP_Highlight"
        hl.FillColor = color
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.4
        hl.Parent = model

        local bb = Instance.new("BillboardGui")
        bb.Name = "ESP_Tag"
        bb.Size = UDim2.new(0, 100, 0, 30)
        bb.AlwaysOnTop = true
        bb.Adornee = model:FindFirstChild("Head") or model
        bb.Parent = model

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.TextColor3 = color
        txt.TextScaled = true
        txt.Font = Enum.Font.SourceSansBold
        txt.Text = labelText
        txt.Parent = bb
    end
end

ESPTab:CreateToggle({
   Name = "เปิดระบบมอง (ผู้บริสุทธิ์/นายอำเภอ/ฆาตกร/ปืน/ชื่อบนหัว)",
   CurrentValue = false,
   Flag = "ESPMasterToggle",
   Callback = function(Value)
      ESPEnabled = Value
      task.spawn(function()
          while ESPEnabled do
              task.wait(1)
              for _, p in pairs(Players:GetPlayers()) do
                  if p ~= LocalPlayer and p.Character then
                      local char = p.Character
                      local isMurderer = char:FindFirstChild("Knife") or (p.Backpack and p.Backpack:FindFirstChild("Knife"))
                      local isSheriff = char:FindFirstChild("Gun") or (p.Backpack and p.Backpack:FindFirstChild("Gun"))

                      if isMurderer then
                          ApplyESP(char, Color3.fromRGB(255, 0, 0), p.Name .. "\n[ฆาตกร]")
                      elseif isSheriff then
                          ApplyESP(char, Color3.fromRGB(0, 100, 255), p.Name .. "\n[นายอำเภอ]")
                      else
                          ApplyESP(char, Color3.fromRGB(0, 255, 100), p.Name .. "\n[ผู้บริสุทธิ์]")
                      end
                  end
              end

              local gunDrop = Workspace:FindFirstChild("GunDrop", true) or Workspace:FindFirstChild("Gun", true)
              if gunDrop then
                  ApplyESP(gunDrop, Color3.fromRGB(255, 255, 0), "[ปืนตกอยู่!]")
              end
          end
      end)
   end,
})

